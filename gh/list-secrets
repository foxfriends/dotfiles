#!/usr/bin/env bash
# List GitHub Actions secret names: repo-level, per environment, and org secrets shared with the repo.
# Usage: list-secrets.sh [owner/repo]   (defaults to the current repo)
set -euo pipefail
repo="${1:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}"
echo "[repo]"
gh secret list -R "$repo" --json name -q '.[].name'
for env in $(gh api "repos/$repo/environments" -q '.environments[].name'); do
  echo "[env: $env]"
  gh secret list -R "$repo" --env "$env" --json name -q '.[].name'
done
echo "[org]"
gh api "repos/$repo/actions/organization-secrets" -q '.secrets[].name'
