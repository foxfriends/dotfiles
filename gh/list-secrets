#!/usr/bin/env bash
# List GitHub Actions secret names: repo-level, per environment, and org secrets shared with the repo.
# Usage: list-secrets.sh [owner/repo]   (defaults to the current repo)
set -uo pipefail
repo="${1:-$(gh repo view --json nameWithOwner -q .nameWithOwner 2> /dev/null)}"
echo "[repo]"
gh secret list -R "$repo" --json name -q '.[].name' 2> /dev/null
for env in $(gh api "repos/$repo/environments" -q '.environments[].name'); do
  echo "[env: $env]"
  gh secret list -R "$repo" --env "$env" --json name -q '.[].name' 2> /dev/null
done

org=$(gh api "repos/$repo/actions/organization-secrets" 2> /dev/null)
if [ $(echo "$org" | jq -r .status) != '422' ]; then
    echo "[org]"
    echo "$org" | jq '.secrets[].name'
fi
echo "[end]"
